<rule id="100432" level="12">
  <if_sid>550</if_sid>
  <field name="file">/etc/passwd|/etc/shadow|/etc/sudoers</field>
  <field name="operation">WRITE</field>
  <description>Critical system file modified</description>
  <group>file_integrity,system_config</group>
</rule>

