    <!--
     Rule: 100100
     Level: 8
     Description: Identifies the execution of common networking tools often used for C2, data exfiltration, or reverse shells.
     This is a foundational rule used for chaining.
    -->
    <rule id="100100" level="8">
      <if_sid>80792</if_sid> <!-- Wazuh's base rule for auditd process execution -->
      <field name="audit.exe" type="pcre2">(netcat|nc|ncat|socat|nmap)$</field>
