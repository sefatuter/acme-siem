<rule id="100410" level="8">
  <if_sid>530</if_sid>
  <field name="cpu_usage">^[89][0-9]|^9[0-9]</field>
  <description>Process consuming excessive CPU resources</description>
  <group>resource_abuse,suspicious_process</group>
</rule>


