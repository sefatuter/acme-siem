<rule id="101530" level="10">
  <field name="file">^/etc/shadow$</field>
  <field name="operation">READ</field>
  <description>Shadow file read outside normal tools</description>
  <group>file_access,credentials</group>
</rule>

<!-- UPDATED -->
<rule id="100620" level="10">
  <!-- Match auditd syscall events -->
  <if_sid>80700</if_sid>
  
  <field name="audit.file.name" type="pcre2">\/etc\/(shadow|gshadow|passwd|sudoers|group|security|pam.d)</field>
  
  <description>🔒 Sensitive authentication file access: $(audit.file.name) by $(audit.exe) (user: $(audit.uid))</description>
  <group>auditd,filesystem,authentication,sensitive_files</group>
</rule>
<!-- 
nano /etc/audit/rules.d/30-auth-read.rules


## This file contains rules to monitor access to sensitive authentication files and directories.
## These rules log any read, write, or attribute change access by regular users (auid>=1000).

## Monitor critical authentication FILES using syscall (-a) rules.
## We use "perm=rwa" to audit read, write, and attribute change events.
-a always,exit -F arch=b64 -F path=/etc/passwd -F perm=rwa -F auid>=1000 -F auid!=-1 -k auth_read
-a always,exit -F arch=b64 -F path=/etc/shadow -F perm=rwa -F auid>=1000 -F auid!=-1 -k auth_read
-a always,exit -F arch=b64 -F path=/etc/gshadow -F perm=rwa -F auid>=1000 -F auid!=-1 -k auth_read
-a always,exit -F arch=b64 -F path=/etc/sudoers -F perm=rwa -F auid>=1000 -F auid!=-1 -k auth_read
-a always,exit -F arch=b64 -F path=/etc/group -F perm=rwa -F auid>=1000 -F auid!=-1 -k auth_read

## Monitor critical authentication DIRECTORIES using watch (-w) rules.
## The -w syntax recursively monitors all files and subdirectories within the given path.
-w /etc/security/ -p rwa -k auth_read -F auid>=1000 -F auid!=-1
-w /etc/pam.d/ -p rwa -k auth_read -F auid>=1000 -F auid!=-1


systemctl restart auditd
-->
