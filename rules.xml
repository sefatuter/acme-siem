<group name="custom_audit_test">

    <rule id="120100" level="7">
        <if_sid>80700</if_sid>
        <field name="audit.exe">/usr/bin/curl</field>
        <description>
            curl command used.
        </description>
        <group>download_stage</group>
    </rule>
    
    <rule id="120101" level="5">
        <if_sid>80700</if_sid>
        <field name="audit.exe">/usr/bin/chmod</field>
        <description>
            chmod command used.
        </description>
        <group>permission_stage</group>
    </rule>
    
    <rule id="120102" level="7">
        <if_sid>80700</if_sid>
        <field name="audit.exe">/usr/bin/nc</field>
        <description>
            nc command used.
        </description>
        <group>execute_stage</group>
    </rule>
    
    <rule id="120103" level="12" frequency="1" timeframe="120">
        <composite>download_stage, permission_stage, execute_stage</composite>
        <frequency>3</frequency> <!-- Must be 3 to count one event from each of the 3 groups -->

        <description>
            Full toolchain curl → chmod → nc used.
            
            Agent: $(agent.name), ip: $(agent_ip)
            Command: $(audit.execve.a0) $(audit.execve.a1) $(audit.execve.a2) $(audit.execve.a3) $(audit.execve.a4)
            
        </description>
        <group>full_attack</group>
    </rule>
    
</group>

